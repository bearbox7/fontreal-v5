# FontReal V5: Google Gemini and OpenAI can both be enabled at the same time.
# Set secrets in Render > Environment. Never publish API keys.
# Set a strong password to protect public paid-AI endpoints.
STUDIO_PASSWORD=

# Direct OpenAI official API (not included in a ChatGPT subscription).
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
OPENAI_IMAGE_MODEL=gpt-image-2

# Google Gemini API: get a key at https://aistudio.google.com/apikey.
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=gemini-3.6-flash
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image

# To use 302.AI *instead* of official OpenAI, change OPENAI_BASE_URL
# to https://api.302.ai/v1 and set its own issued key as OPENAI_API_KEY.
# A 302.AI key and an official OpenAI key are NOT interchangeable.

# GrsAI / grsai.ai independent third provider (NOT a self-hosted URL).
# API Base URL is an API node, not https://grsai.ai/zh/v1 (which is documentation).
GRSAI_API_KEY=
GRSAI_BASE_URL=https://grsaiapi.com
GRSAI_ANALYSIS_MODEL=gemini-2.5-flash
# 4K-capable model is optional for future large-sheet workflow.
GRSAI_IMAGE_MODEL=gpt-image-2.5-flare
