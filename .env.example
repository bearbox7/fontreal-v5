# FontReal V5 — 302.AI (set these securely in Render > Environment)
# Keep STUDIO_PASSWORD configured to prevent strangers from using paid AI requests.
STUDIO_PASSWORD=
# 302.AI-issued API key, NOT an OpenAI platform API key. NEVER commit the real value.
OPENAI_API_KEY=
# 302.AI official OpenAI-compatible endpoint
OPENAI_BASE_URL=https://api.302.ai/v1
# Multimodal model using 302.AI /v1/responses for analyzing reference images.
# Verify account's actual model entitlement in 302.AI dashboard.
OPENAI_ANALYSIS_MODEL=gpt-4.1-mini
# gpt-image-2 supports larger images (including 3840x2160 glyph sheet).
# Other GPT Image models generally support 1024x1024/1536x1024/1024x1536 only.
OPENAI_IMAGE_MODEL=gpt-image-2

# Optional Google Gemini provider (not required for 302.AI)
GEMINI_API_KEY=
GEMINI_ANALYSIS_MODEL=
GEMINI_IMAGE_MODEL=
